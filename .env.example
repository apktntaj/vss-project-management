# Server-only Supabase credentials. Never expose the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

AUTH_SECRET=generate-a-long-random-secret

# Required only for npm run supabase:create-user
# VSS_USER_PASSWORD=use-a-long-unique-password

GEMINI_API_KEY="your-gemini-api-key"

# INSW CMS (recommended for verified LARTAS). Do not commit credential values.
LARTAS_BASE_URL="https://api.insw.go.id"
LARTAS_TOKEN=""
# Or provide a server-local file path instead of LARTAS_TOKEN.
LARTAS_TOKEN_FILE_PATH=""
LARTAS_REQUEST_TIMEOUT_MS="30000"
# Optional: refresh the INSW CMS token through SSO.
INSW_CLIENT_ID=""
INSW_CLIENT_BEARER=""
