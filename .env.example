# Server-only Supabase credentials. Never expose the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

AUTH_SECRET=generate-a-long-random-secret

# Required only for npm run supabase:create-user
# VSS_USER_PASSWORD=use-a-long-unique-password

GEMINI_API_KEY="your-gemini-api-key"

# Wajib untuk ekstraksi dokumen oleh LLM. Tanpa LLM_PROVIDER default SUMOPOD
# (gateway OpenAI-compatible https://ai.sumopod.com/v1).
# LLM_PROVIDER=SUMOPOD|CLAUDE|DEEPSEEK
# LLM_API_KEY=
# Opsional: timpa model bawaan provider (SUMOPOD gpt-4o-mini, CLAUDE claude-3-5-haiku-latest,
# DEEPSEEK deepseek-chat).
# LLM_MODEL=
# Opsional: timpa base URL (hanya SUMOPOD), mis. gateway OpenAI-compatible lain.
# LLM_BASE_URL=

# INSW CMS (recommended for verified LARTAS). Do not commit credential values.
LARTAS_BASE_URL="https://api.insw.go.id"
LARTAS_TOKEN=""
# Or provide a server-local file path instead of LARTAS_TOKEN.
LARTAS_TOKEN_FILE_PATH=""
LARTAS_REQUEST_TIMEOUT_MS="30000"
# Optional: refresh the INSW CMS token through SSO.
INSW_CLIENT_ID=""
INSW_CLIENT_BEARER=""

# CEISA 4.0 server-only connection. Credentials are stored encrypted in Supabase.
CEISA_CREDENTIAL_ENCRYPTION_KEY=""
CEISA_BASE_URL="https://apis-gw.beacukai.go.id/v2/openapi"
CEISA_AUTH_BASE_URL="https://apis-gw.beacukai.go.id/v1/openapi-auth"
CEISA_ORIGIN=""
CEISA_REQUEST_TIMEOUT_MS="30000"

# ──────────────────────────────────────────────────────────────────────────────
# Deploy VPS (Docker + Caddy). Hanya dibutuhkan saat deploy via docker-compose.
# DOMAIN = nama domain publik aplikasi (Caddy menerbitkan TLS untuknya).
# ACME_EMAIL = email akun Let's Encrypt untuk notifikasi sertifikat.
# ──────────────────────────────────────────────────────────────────────────────
DOMAIN="vss.example.com"
ACME_EMAIL="ops@example.com"
